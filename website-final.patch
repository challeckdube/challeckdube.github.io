+<h1>Talks &amp; seminars</h1>
+<p>Talks listed in my <a href="{{ site.data.site.cv | relative_url }}">curriculum vitae</a>, in reverse chronological order.</p>
+{% for talk in site.data.talks %}
+{% assign year = talk.date | slice: 0, 4 %}
+{% if forloop.first %}
+<section aria-labelledby="year-{{ year }}"><h2 id="year-{{ year }}">{{ year }}</h2>
+{% elsif year != previous_year %}
+</section><section aria-labelledby="year-{{ year }}"><h2 id="year-{{ year }}">{{ year }}</h2>
+{% endif %}
+<article class="entry">
+  <p class="entry-meta"><time datetime="{{ talk.date | escape }}">{{ talk.display_date | escape }}</time>{% if talk.invited %} · Invited talk{% endif %}</p>
+  <h3>{{ talk.title | escape }}</h3>
+  <p>{{ talk.venue | escape }}</p>
+  {% if talk.collaborators %}<p>With {{ talk.collaborators | escape }}.</p>{% endif %}
+</article>
+{% assign previous_year = year %}
+{% if forloop.last %}</section>{% endif %}
+{% endfor %}
